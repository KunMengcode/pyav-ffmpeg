diff --git a/libavformat/demux.c b/libavformat/demux.c
--- a/libavformat/demux.c	(revision d65f4643833429d2128df8bbe8ffb24e9240362b)
+++ b/libavformat/demux.c	(date 1778057009472)
@@ -1289,6 +1289,8 @@
         out_pkt->dts          = sti->parser->dts;
         out_pkt->pos          = sti->parser->pos;
         out_pkt->flags       |= pkt->flags & (AV_PKT_FLAG_DISCARD | AV_PKT_FLAG_CORRUPT);
+        out_pkt->time_real_sec = pkt->time_real_sec;
+        out_pkt->time_real_usec = pkt->time_real_usec;
 
         if (sti->need_parsing == AVSTREAM_PARSE_FULL_RAW)
             out_pkt->pos = sti->parser->frame_offset;
